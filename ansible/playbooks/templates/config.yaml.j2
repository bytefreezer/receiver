# ByteFreezer Receiver Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Host: {{ ansible_hostname }}

app:
  name: {{ config.app.name }}
  version: {{ config.app.version }}

# Logging configuration
logging:
  level: {{ config.logging.level }}
  encoding: {{ config.logging.encoding }}

# API server configuration
server:
  api_port: {{ config.server.api_port }}

# ByteFreezer configuration - Three-stage spooling pipeline
bytefreezer:
  upload_worker_count: {{ config.bytefreezer.upload_worker_count }}
  # Three-stage pipeline: queue → retry → S3/DLQ
  spool_path: {{ paths.spool_dir }}

# Control Service configuration (replaces dev mode and legacy controller)
control_service:
  enabled: {{ config.control_service.enabled | lower }}
  base_url: {{ config.control_service.base_url }}
  api_key: "{{ config.control_service.api_key | default('bytefreezer-service-api-key-8f4a2d1b-3c5e-4f6a-9b8c-7d2e1f3a4b5c') }}"
  timeout_seconds: {{ config.control_service.timeout_seconds }}

# Authentication configuration
authentication:
  enabled: {{ config.authentication.enabled | lower }}

# OpenTelemetry configuration
otel:
  enabled: {{ config.otel.enabled | lower }}
  service_name: {{ config.otel.service_name }}
  scrapeIntervalseconds: {{ config.otel.scrapeIntervalseconds }}
  # Prometheus mode - expose metrics on HTTP endpoint for scraping
  prometheus_mode: {{ config.otel.prometheus_mode | lower }}
  metrics_port: {{ config.otel.metrics_port }}
  # Bind to all interfaces for external scraping
  metrics_host: {{ config.otel.metrics_host }}

# Housekeeping configuration
housekeeping:
  enabled: {{ config.housekeeping.enabled | lower }}
  intervalseconds: {{ config.housekeeping.intervalseconds }}

# S3 destination configuration
s3destination:
  bucket_name: {{ config.s3destination.bucket_name }}
  region: {{ config.s3destination.region }}
  endpoint: {{ config.s3destination.endpoint }}
  ssl: {{ config.s3destination.ssl | lower }}
  access_key: {{ config.s3destination.access_key }}
  secret_key: {{ config.s3destination.secret_key }}
  use_iam_role: {{ config.s3destination.use_iam_role | default(false) | lower }}

# Raw data ingestion - format-agnostic processing
protocols:
  # Webhook ingestion - HTTP POST endpoints
  webhook:
    enabled: {{ config.protocols.webhook.enabled | default(true) | lower }}
    port: {{ config.protocols.webhook.port | default(8080) }}
    max_payload_size: {{ config.protocols.webhook.max_payload_size | default(10485760) }}
  # File upload ingestion - batch file uploads (raw data)
  upload:
    enabled: {{ config.protocols.upload.enabled | default(false) | lower }}
    max_file_size: {{ config.protocols.upload.max_file_size | default(104857600) }}

# SOC configuration
soc:
  enabled: {{ config.soc.enabled | lower }}

# Dead Letter Queue (DLQ) configuration for failed uploads
dlq:
  enabled: {{ config.dlq.enabled | lower }}
  directory: {{ config.dlq.directory }}
  retry_attempts: {{ config.dlq.retry_attempts }}
  retry_interval_seconds: {{ config.dlq.retry_interval_seconds }}
  cleanup_interval_seconds: {{ config.dlq.cleanup_interval_seconds }}
  max_age_days: {{ config.dlq.max_age_days }}

# Health reporting configuration (uses control_service.base_url)
health_reporting:
  enabled: {{ config.health_reporting.enabled | default(true) | lower }}
  report_interval: {{ config.health_reporting.report_interval | default(30) }}
  timeout_seconds: {{ config.health_reporting.timeout_seconds | default(10) }}
  register_on_startup: {{ config.health_reporting.register_on_startup | default(true) | lower }}

# Error tracking configuration (uses control_service.base_url)
error_tracking:
  enabled: {{ config.error_tracking.enabled | default(true) | lower }}

# Development mode
dev: {{ config.dev | lower }}
# ByteFreezer Receiver Log Rotation Configuration
# Generated by Ansible

# Main application logs
# Rotate when file reaches {{ logrotate.size | default('100M') }} OR daily, whichever comes first
# maxsize {{ logrotate.maxsize | default('1G') }} ensures total logs stay under limit
{{ paths.log_dir }}/*.log {
    daily
    size {{ logrotate.size | default('100M') }}
    maxsize {{ logrotate.maxsize | default('1G') }}
    missingok
    rotate {{ logrotate.rotate_count | default(7) }}
    compress
    delaycompress
    notifempty
    create 0644 {{ service.user }} {{ service.group }}
    sharedscripts

    postrotate
        if systemctl is-active {{ service.name }} >/dev/null 2>&1; then
            systemctl reload {{ service.name }}
        fi
    endscript
}
